<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copy to ~/Library/LaunchAgents/com.pios.unifi-intel-collect.plist after Phase 0.
  Do NOT load during the 48h WAN gate unless you accept extra API traffic.

  launchctl load ~/Library/LaunchAgents/com.pios.unifi-intel-collect.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pios.unifi-intel-collect</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/eduardofgiovannini/Documents/GitHub/AUTOGIO_PIOS/scripts/collect.zsh</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/eduardofgiovannini/Documents/GitHub/AUTOGIO_PIOS/data/reports/intel_collect_stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/eduardofgiovannini/Documents/GitHub/AUTOGIO_PIOS/data/reports/intel_collect_stderr.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
  </dict>
</dict>
</plist>
