# Copy to .unifi.local.env and fill in local UCG admin credentials.
# Do NOT use Ubiquiti SSO email — MFA blocks API login.
#
# Create account (Network 10.x):
#   https://192.168.0.1/network/default/admins → + Create New
#   Local Site account (not Fabric invite)
# Username: pios-local-admin | Role: Super Admin or Site Admin
# Verified Jul 13, 2026 as display name "PIOS Local"

UNIFI_HOST=192.168.0.1
UNIFI_SITE=default
UNIFI_USERNAME=pios-local-admin
UNIFI_PASSWORD=change-me
